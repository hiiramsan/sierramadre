---
import "../styles/global.css";
import Navbar from '../components/Navbar.tsx';
import Hero from '../components/Hero.tsx';
import StorySection from '../components/StorySection.tsx';
import CollectionSection from '../components/CollectionSection.tsx';
import ContactFooter from '../components/ContactFooter.tsx';
import InfoSection from "../components/InfoSection";
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&display=swap"
      rel="stylesheet"
    />
    <title>Bacanora Sierra Madre</title>
  </head>
  <body>
    <Navbar client:load />
    <Hero />
    <InfoSection />
    <CollectionSection />
    <ContactFooter />

    <script>
      import { gsap } from "gsap";
      import { ScrollTrigger } from "gsap/ScrollTrigger";

      gsap.registerPlugin(ScrollTrigger);

      // ── 1. HERO EXIT — faster (50vh pin distance) ─────────────────────
      gsap.timeline({
        scrollTrigger: {
          trigger: "#hero-section",
          start: "top top",
          end: "+=50%",
          scrub: 1,
          pin: true,
          anticipatePin: 1,
        },
      })
        .to("#hero-text",   { opacity: 0, y: -60, ease: "power2.in",  duration: 0.5 })
        .to("#hero-bottle", { opacity: 0, y:  80, ease: "power1.in",  duration: 0.7 }, "<0.2")
        .to("#hero-card",   { opacity: 0, x: -80, ease: "power2.in",  duration: 0.5 }, "<");

      // ── 2. ORIGIN SECTION ──────────────────────────────────────────────
      const originBottle = document.getElementById("origin-bottle") as HTMLElement | null;
      const originText = document.getElementById("origin-text") as HTMLElement | null;
      const originMap = document.getElementById("origin-map") as HTMLElement | null;

      if (originBottle && originText && originMap) {
        gsap.set(originText, { opacity: 0, y: 34 });

        ScrollTrigger.create({
          trigger: "#story-section",
          start: "top top",
          end: "+=1200",
          pin: true,
          scrub: 0.55,
          anticipatePin: 1,
          onUpdate(self) {
            const p = self.progress;

            // Move bottle through a curved route over the map.
            const maxX = Math.min(260, window.innerWidth * 0.35);
            const x = gsap.utils.interpolate(-20, maxX, p);
            const y = gsap.utils.interpolate(30, -130, p);
            const rot = gsap.utils.interpolate(-6, 8, p);
            const scale = gsap.utils.interpolate(0.94, 1.05, p);

            originBottle.style.transform = `translate(${x}px, ${y}px) rotate(${rot}deg) scale(${scale})`;
            originMap.style.transform = `scale(${gsap.utils.interpolate(1, 1.09, p)}) translateY(${gsap.utils.interpolate(0, -26, p)}px)`;

            const textOpacity = gsap.utils.clamp(0, 1, (p - 0.18) / 0.35);
            const textY = gsap.utils.interpolate(34, 0, gsap.utils.clamp(0, 1, (p - 0.14) / 0.34));
            originText.style.opacity = String(textOpacity);
            originText.style.transform = `translateY(${textY}px)`;
          },
        });
      }

      // ── 3. COLLECTION SECTION entrance ──────────────────────────────────
      gsap.fromTo(".collection-bottle",
        { opacity: 0, y: 100 },
        {
          opacity: 1,
          y: 0,
          duration: 0.9,
          ease: "power3.out",
          stagger: 0.15,
          scrollTrigger: {
            trigger: "#collection-section",
            start: "top 75%",
            end: "bottom 25%",
            // Replay the entrance when entering from either direction.
            toggleActions: "restart none restart reset",
          },
        }
      );

      // Switch navbar text color when the navbar sits over the white contact section.
      const navEl = document.getElementById("site-navbar");
      const contactEl = document.getElementById("contact-section");

      if (navEl && contactEl) {
        let ticking = false;

        const updateNavbarTheme = () => {
          const navRect = navEl.getBoundingClientRect();
          const contactRect = contactEl.getBoundingClientRect();
          const navProbeY = navRect.top + navRect.height * 0.65;
          const isOverContact = contactRect.top <= navProbeY && contactRect.bottom >= navProbeY;

          navEl.setAttribute("data-theme", isOverContact ? "light" : "dark");
        };

        const scheduleThemeUpdate = () => {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(() => {
            updateNavbarTheme();
            ticking = false;
          });
        };

        window.addEventListener("scroll", scheduleThemeUpdate, { passive: true });
        window.addEventListener("resize", scheduleThemeUpdate);
        ScrollTrigger.addEventListener("refresh", scheduleThemeUpdate);

        updateNavbarTheme();
      }
    </script>
  </body>
</html>